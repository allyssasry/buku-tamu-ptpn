<mxCell id="t1" value="Mulai Kunjungan
(Akses Kiosk Lobby)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#10b981;strokeColor=#059669;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="lane_tamu">
