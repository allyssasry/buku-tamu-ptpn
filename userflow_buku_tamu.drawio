<mxCell id="t2" value="Pilih Kategori:
1. Tamu Umum / Dinas
2. Anak Magang / PKL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;fontSize=11;fontStyle=0;" vertex="1" parent="lane_tamu">
    <mxGeometry x="70" y="140" width="200" height="55" as="geometry" />
  </mxCell>
<mxCell id="t3" value="Isi Form Registrasi:
- Identitas &amp; Kontak (HP/WA)
- Bertemu &amp; 19 Pilihan Divisi
- Ambil Foto Diri / Wajah (Auto Compress)
- Persetujuan Kebijakan Data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;fontSize=11;fontStyle=0;" vertex="1" parent="lane_tamu">
    <mxGeometry x="60" y="230" width="220" height="90" as="geometry" />
  </mxCell>
<mxCell id="t4" value="Klik &quot;Kirim Pendaftaran&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;fontSize=11;fontStyle=0;" vertex="1" parent="lane_tamu">
    <mxGeometry x="90" y="355" width="160" height="45" as="geometry" />
  </mxCell>
<mxCell id="t5" value="Halaman Sukses Registrasi
- Tampil Nomor Kartu Looping
- Instruksi ke Pos Security Lt. 11
(Menitipkan ID &amp; Ambil Kartu)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;fontSize=11;fontStyle=0;" vertex="1" parent="lane_tamu">
    <mxGeometry x="60" y="490" width="220" height="80" as="geometry" />
  </mxCell>
<mxCell id="t6" value="Tamu Menuju Pos Security Lt. 11
Serahkan ID Asli (KTP/SIM/Kartu Pelajar)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;fontSize=11;fontStyle=0;" vertex="1" parent="lane_tamu">
    <mxGeometry x="60" y="610" width="220" height="60" as="geometry" />
  </mxCell>
<mxCell id="t7" value="Terima Kartu Akses Fisik
&amp; Melakukan Kunjungan di Gedung" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;fontSize=11;fontStyle=0;" vertex="1" parent="lane_tamu">
    <mxGeometry x="60" y="755" width="220" height="55" as="geometry" />
  </mxCell>
<mxCell id="t8" value="Kunjungan Selesai:
Kembali ke Pos Security Lt. 11
Kembalikan Kartu &amp; Ambil KTP/ID" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;fontSize=11;fontStyle=0;" vertex="1" parent="lane_tamu">
    <mxGeometry x="60" y="880" width="220" height="65" as="geometry" />
  </mxCell>
<mxCell id="t9" value="Selesai Berkunjung
(Meninggalkan Gedung)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ef4444;strokeColor=#dc2626;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="lane_tamu">
    <mxGeometry x="100" y="985" width="140" height="50" as="geometry" />
  </mxCell>
<mxCell id="s1" value="Login Petugas Security
(/login)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#10b981;strokeColor=#059669;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="lane_security">
    <mxGeometry x="115" y="60" width="140" height="50" as="geometry" />
  </mxCell>
<mxCell id="s2" value="Buka Security Book / Daftar Tamu
Lihat Antrean &quot;Menunggu Verifikasi&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1e3a8a;fontSize=11;fontStyle=0;" vertex="1" parent="lane_security">
    <mxGeometry x="75" y="225" width="220" height="55" as="geometry" />
  </mxCell>
<mxCell id="s3" value="Klik Tombol &quot;Verifikasi Tamu&quot;
(Membuka Modal Validasi Kedatangan)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1e3a8a;fontSize=11;fontStyle=0;" vertex="1" parent="lane_security">
    <mxGeometry x="75" y="490" width="220" height="50" as="geometry" />
  </mxCell>
<mxCell id="s4" value="Proses Verifikasi di Modal:
1. Cek Foto Wajah Tamu &amp; Divisi
2. PILIH LANTAI TUJUAN (Lt 11 / 15 / 16)
3. Tampil No. Kartu Looping (001-050)
4. Centang Titip KTP &amp; No. Loker
5. Input Catatan Tambahan (Opsional)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1e3a8a;fontSize=11;fontStyle=0;" vertex="1" parent="lane_security">
    <mxGeometry x="55" y="575" width="260" height="110" as="geometry" />
  </mxCell>
<mxCell id="s5" value="Klik &quot;Konfirmasi &amp; Izinkan Masuk&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1e3a8a;fontSize=11;fontStyle=0;" vertex="1" parent="lane_security">
    <mxGeometry x="75" y="715" width="220" height="45" as="geometry" />
  </mxCell>
<mxCell id="s6" value="Serahkan Kartu Akses Fisik ke Tamu
&amp; Simpan KTP di Loker Security" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1e3a8a;fontSize=11;fontStyle=0;" vertex="1" parent="lane_security">
    <mxGeometry x="75" y="785" width="220" height="55" as="geometry" />
  </mxCell>
<mxCell id="s7" value="Saat Tamu Hendak Pulang:
Klik Tombol &quot;Check-Out Keluar&quot;
Kembalikan KTP &amp; Simpan Kartu Akses" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1e3a8a;fontSize=11;fontStyle=0;" vertex="1" parent="lane_security">
    <mxGeometry x="75" y="880" width="220" height="65" as="geometry" />
  </mxCell>
<mxCell id="s8" value="Patroli Keamanan Area:
Input Pengecekan Area Gedung
(Pilih Gedung &amp; 8 Master Area,
Status Aman/Insiden, Upload Foto)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1e3a8a;fontSize=11;fontStyle=0;" vertex="1" parent="lane_security">
    <mxGeometry x="65" y="980" width="240" height="75" as="geometry" />
  </mxCell>
<mxCell id="b1" value="POST /api/guests
- Validasi Input Tamu
- Auto-Assign Next Card (001-050)
- Set Status: &quot;Menunggu Verifikasi&quot;
- Simpan Foto Wajah (Base64)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#475569;fontColor=#0f172a;fontSize=11;fontStyle=0;" vertex="1" parent="lane_backend">
    <mxGeometry x="60" y="360" width="220" height="85" as="geometry" />
  </mxCell>
<mxCell id="b2" value="Database TiDB Cloud
Simpan Record Tamu Baru
(submitted_at: now())" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#475569;fontColor=#0f172a;fontSize=11;fontStyle=0;" vertex="1" parent="lane_backend">
    <mxGeometry x="70" y="475" width="200" height="55" as="geometry" />
  </mxCell>
<mxCell id="b3" value="POST /api/guests/{id}/verify
- Update destination_floor (11/15/16)
- Auto Check-In: &quot;Sedang Berkunjung&quot;
- Timestamp: verified_at &amp; check_in_at
- Simpan IdentityDeposit (Loker KTP)
- Simpan Catatan Tambahan Security
- Catat ke Audit Log Security" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#475569;fontColor=#0f172a;fontSize=11;fontStyle=0;" vertex="1" parent="lane_backend">
    <mxGeometry x="50" y="670" width="240" height="115" as="geometry" />
  </mxCell>
<mxCell id="b4" value="POST /api/guests/{id}/checkout
- Status: &quot;Sudah Keluar&quot;
- Timestamp: check_out_at = now()
- Kembalikan Status KTP ke &quot;Dikembalikan&quot;
- Bebaskan No. Kartu untuk Siklus Looping" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#475569;fontColor=#0f172a;fontSize=11;fontStyle=0;" vertex="1" parent="lane_backend">
    <mxGeometry x="50" y="880" width="240" height="85" as="geometry" />
  </mxCell>
<mxCell id="b5" value="POST /api/security-logs
Simpan Catatan Patroli Area Gedung
(Status, Foto Patroli, Timestamp)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#475569;fontColor=#0f172a;fontSize=11;fontStyle=0;" vertex="1" parent="lane_backend">
    <mxGeometry x="60" y="995" width="220" height="60" as="geometry" />
  </mxCell>
<mxCell id="a1" value="Login Admin / Pimpinan
(/login)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#10b981;strokeColor=#059669;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="lane_admin">
    <mxGeometry x="115" y="60" width="140" height="50" as="geometry" />
  </mxCell>
<mxCell id="a2" value="Executive Monitoring Dashboard
(/dashboard):
- Kartu Statistik: Tamu Hari Ini, Bulan Ini,
Sedang di Gedung (Realtime)
- Rekapitulasi Tamu per Lantai (11, 15, 16)
- Rekapitulasi per 19 Divisi &amp; Direksi
- Rekapitulasi Patroli Security Book" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#9333ea;fontColor=#581c87;fontSize=11;fontStyle=0;" vertex="1" parent="lane_admin">
    <mxGeometry x="55" y="160" width="260" height="115" as="geometry" />
  </mxCell>
<mxCell id="a3" value="Fitur Drill-Down Interaktif:
Klik Kotak Metrik Lantai / Divisi
-&gt; Muncul Modal Daftar Tamu Terkait
-&gt; Tombol &quot;Buka Halaman Lengkap&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#9333ea;fontColor=#581c87;fontSize=11;fontStyle=0;" vertex="1" parent="lane_admin">
    <mxGeometry x="65" y="305" width="240" height="75" as="geometry" />
  </mxCell>
<mxCell id="a4" value="Menu Buku Tamu Gedung (/guests):
- Filter &amp; Pencarian Lengkap
- Modal Detail Tamu (Ikon Mata):
  * Foto Wajah Tamu
  * Lantai Tujuan &amp; Divisi
  * Waktu Pengisian, Verifikasi &amp; Keluar
  * Catatan Tambahan dari Security" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#9333ea;fontColor=#581c87;fontSize=11;fontStyle=0;" vertex="1" parent="lane_admin">
    <mxGeometry x="55" y="415" width="260" height="110" as="geometry" />
  </mxCell>
<mxCell id="a5" value="Menu Rekap &amp; Laporan (/reports):
- Filter Berdasarkan Periode &amp; Divisi
- Export Laporan Rekap ke Excel &amp; PDF" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#9333ea;fontColor=#581c87;fontSize=11;fontStyle=0;" vertex="1" parent="lane_admin">
    <mxGeometry x="65" y="560" width="240" height="65" as="geometry" />
  </mxCell>
<mxCell id="a6" value="Master Data &amp; Kontrol:
- Master Gedung (Graha Nusa Tiga &amp; Agro Plaza)
- Master Area Gedung (8 Checkpoint Area)
- Manajemen User (Admin, Security, Pimpinan)
- Audit Log Aktivitas Sistem" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#9333ea;fontColor=#581c87;fontSize=11;fontStyle=0;" vertex="1" parent="lane_admin">
    <mxGeometry x="55" y="665" width="260" height="95" as="geometry" />
  </mxCell>
